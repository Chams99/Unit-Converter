CONVERTAL_DOMAIN=units.chames.tn
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=myresolver

# Optional. Leave blank to use the no-key Frankfurter adapter.
CURRENCYAPI_API_KEY=

# Traefik token bucket for /api/* per RemoteAddr.
API_RATE_AVERAGE=60
API_RATE_PERIOD=1m
API_RATE_BURST=20
IMAGE_RATE_AVERAGE=6

# Container memory ceilings; adjust after observing real use.
API_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
WEB_CPU_LIMIT=0.5
