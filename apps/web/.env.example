# Used by next.config.js when compiling the same-origin /api/* rewrite.
# Set this to the reachable API origin before `pnpm --filter @universal-convertal/web build`.
CONVERTAL_API_URL=http://localhost:8787
# Optional public origin for absolute link-preview image URLs, for example https://units.chames.tn.
# Docker Compose derives it from CONVERTAL_DOMAIN.
CONVERTAL_SITE_URL=
